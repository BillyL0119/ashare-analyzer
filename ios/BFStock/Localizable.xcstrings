    "dl.d.externality.shocks.training": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Firms train workers who later move on"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des salariés formés par une entreprise partent ailleurs"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "企業が育てた社員が転職"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기업이 교육한 직원이 이직"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "企业培训的员工后来跳槽"
          }
        }
      }
    },
    "dl.d.externality.shocks.vaccines": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaccinations"
          }
        },
        "fr": {
