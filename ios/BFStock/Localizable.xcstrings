    "dl.cardApp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag supply and demand, AD–AS, externality, tariff and exchange-rate diagrams, labelled the way examiners expect."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Manipulez les graphiques d'offre et de demande, AD–AS, externalités, droits de douane et taux de change, légendés comme l'attendent les correcteurs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "需要と供給、AD–AS、外部性、関税、為替の図をドラッグで動かせます。採点者が求めるラベル付きです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수요·공급, AD–AS, 외부효과, 관세, 환율 그래프를 드래그해 보세요. 채점자가 요구하는 표기 그대로 보여 줍니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动供求、AD–AS、外部性、关税和汇率图，按考官要求的方式标注。"
          }
        }
      }
    },
