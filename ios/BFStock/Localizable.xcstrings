    "dl.d.adas.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Label the axes price level and real GDP (or real output), never price and quantity. Show the gap between equilibrium output and full-employment output."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nommez les axes niveau des prix et PIB réel (ou production réelle), jamais prix et quantité. Montrez l'écart entre la production d'équilibre et celle de plein emploi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "軸は「物価水準」と「実質GDP（実質産出量）」とし、「価格」「数量」とは書かないこと。均衡産出量と完全雇用産出量の差を示しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "축 이름은 물가수준과 실질 GDP(실질 산출)로 쓰고, 가격과 수량으로 쓰지 마세요. 균형 산출과 완전고용 산출의 차이를 표시하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "坐标轴要写物价水平和实际 GDP（或实际产出），不能写价格和数量。标出均衡产出与充分就业产出之间的缺口。"
          }
        }
      }
    },
    "dl.d.controls.blurb": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A legal maximum or minimum price, and the shortage or surplus it creates."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un prix maximum ou minimum fixé par la loi, et la pénurie ou l'excédent qu'il crée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "法律で決めた最高価格・最低価格と、それが生む品不足や売れ残り。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "법으로 정한 최고 또는 최저 가격과, 그로 인한 부족이나 초과공급."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "法定的最高或最低价格，以及它带来的短缺或过剩。"
          }
        }
      }
    },
    "dl.d.controls.ceilingLine.alevel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximum price"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
