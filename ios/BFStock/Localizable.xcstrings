      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Average inflation people expect over the next ten years (surveys). The higher it is, the harder inflation is to bring down."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'inflation moyenne attendue sur dix ans (enquêtes). Plus elle est élevée, plus l'inflation est difficile à faire baisser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後10年の平均インフレ率の予想（調査）。高いほどインフレは下がりにくくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞으로 10년간 사람들이 예상하는 평균 물가상승률(설문). 높을수록 물가를 낮추기 어렵습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "人们预计未来十年的平均通胀（调查数据）。预期越高，通胀越难降下来。"
          }
        }
      }
    },
    "gv.fedSet": {
