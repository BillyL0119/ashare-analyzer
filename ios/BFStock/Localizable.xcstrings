    "dl.d.externality.shocks.smoking": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smoking (second-hand smoke)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabac (tabagisme passif)"
          }
        },
        "ja": {
