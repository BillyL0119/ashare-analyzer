    "gv.source": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data: the Federal Reserve Board's FRB/US database (official BLS, BEA and Fed figures). Where your choices differ from the real Fed's, a simplified textbook model works out the difference; it is not a forecast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données : base FRB/US de la Réserve fédérale (chiffres officiels du BLS, du BEA et de la Fed). Là où vos choix diffèrent de ceux de la Fed, un modèle de manuel simplifié calcule l'écart ; ce n'est pas une prévision."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データ：FRBのFRB/USデータベース（労働統計局、経済分析局、FRBの公式データ）。あなたの判断がFRBと違う部分は、簡略化した教科書的モデルで計算しています。予測ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터: 연준의 FRB/US 데이터베이스(노동통계국, 경제분석국, 연준 공식 수치). 당신의 선택이 연준과 다른 부분은 단순화한 교과서 모델로 계산하며, 예측이 아닙니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据：美联储 FRB/US 模型数据库（劳工统计局、经济分析局和美联储的官方数据）。你和真实美联储不同的部分由一个简化的教科书模型计算，不是预测。"
          }
        }
      }
    },
