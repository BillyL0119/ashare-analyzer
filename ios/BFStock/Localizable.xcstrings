    "dl.d.sd.shocks.substitute": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A substitute gets dearer"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un substitut devient plus cher"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "代替財が値上がり"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대체재 가격 상승"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "替代品变贵"
          }
        }
      }
    },
    "dl.d.sd.shocks.tech": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New technology cuts costs"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une nouvelle technologie réduit les coûts"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新技術でコストが下がる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신기술로 비용 하락"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新技术降低成本"
          }
        }
      }
    },
    "dl.d.sd.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw the old and the new curve and number them (D₁ → D₂). Run dashed lines from both equilibria to the axes so P₁, P₂, Q₁ and Q₂ can be read off."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracez l'ancienne et la nouvelle courbe et numérotez-les (D₁ → D₂). Reliez chaque équilibre aux axes en pointillés pour lire P₁, P₂, Q₁ et Q₂."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の曲線と新しい曲線の両方を描き、番号を付けます（D₁ → D₂）。両方の均衡点から軸へ点線を引き、P₁・P₂・Q₁・Q₂ を示しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원래 곡선과 새 곡선을 모두 그리고 번호를 붙이세요(D₁ → D₂). 두 균형점에서 축까지 점선을 그어 P₁, P₂, Q₁, Q₂를 표시하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新旧两条曲线都要画出来并编号（D₁ → D₂），从两个均衡点向两条轴画虚线，标出 P₁、P₂、Q₁、Q₂。"
          }
        }
      }
    },
    "dl.d.tariff.blurb": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tax on imports in a small open economy: world price, domestic supply and demand, imports, revenue and the two deadweight-loss triangles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une taxe sur les importations dans une petite économie ouverte : prix mondial, offre et demande intérieures, importations, recette et les deux triangles de perte sèche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小国開放経済での輸入関税：世界価格、国内の需要と供給、輸入量、関税収入、2つの死荷重の三角形。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소규모 개방경제의 수입 관세: 세계가격, 국내 수요와 공급, 수입량, 관세수입, 두 개의 사중손실 삼각형."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小型开放经济对进口征税：世界价格、国内供求、进口量、关税收入和两个无谓损失三角形。"
          }
        }
      }
    },
    "dl.d.tariff.dragLine": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "World price plus tariff: drag up or down"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prix mondial plus droit de douane : glisser vers le haut ou le bas"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "世界価格＋関税：上下にドラッグ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세계가격 + 관세: 위아래로 드래그"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "世界价格加关税：上下拖动"
          }
        }
      }
    },
    "dl.d.tariff.ex.areas": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Domestic producers gain area a and the government collects c; b and d are deadweight losses. Consumers lose a + b + c + d."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les producteurs nationaux gagnent l'aire a et l'État perçoit c ; b et d sont des pertes sèches. Les consommateurs perdent a + b + c + d."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "国内生産者は面積 a を得て、政府は c を徴収します。b と d は死荷重で、消費者は a + b + c + d を失います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "국내 생산자는 면적 a를 얻고 정부는 c를 걷습니다. b와 d는 사중손실이며, 소비자는 a + b + c + d를 잃습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "国内生产者获得面积 a，政府收入 c，b 和 d 是无谓损失。消费者损失 a + b + c + d。"
          }
        }
      }
    },
    "dl.d.tariff.ex.imposed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Under free trade the price is the world price Pw: domestic firms supply Q₁, consumers buy Q₄, and imports fill the gap. The tariff raises the price to Pw + t: domestic output rises to Q₂, consumption falls to Q₃, and imports shrink to Q₂–Q₃."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En libre-échange, le prix est le prix mondial Pw : les entreprises nationales offrent Q₁, les consommateurs achètent Q₄ et les importations comblent l'écart. Le droit de douane porte le prix à Pw + t : la production nationale passe à Q₂, la consommation tombe à Q₃ et les importations se réduisent à Q₂–Q₃."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自由貿易では価格は世界価格 Pw で、国内企業は Q₁ を供給し、消費者は Q₄ を買い、差を輸入が埋めます。関税で価格が Pw + t に上がると、国内生産は Q₂ に増え、消費は Q₃ に減り、輸入は Q₂–Q₃ に縮みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자유무역에서는 가격이 세계가격 Pw로, 국내 기업은 Q₁을 공급하고 소비자는 Q₄를 사며 차이는 수입이 채웁니다. 관세로 가격이 Pw + t로 오르면 국내 생산은 Q₂로 늘고, 소비는 Q₃로 줄며, 수입은 Q₂–Q₃로 줄어듭니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自由贸易时价格等于世界价格 Pw：国内企业供给 Q₁，消费者购买 Q₄，差额靠进口。关税把价格抬到 Pw + t：国内产量升到 Q₂，消费降到 Q₃，进口缩小为 Q₂–Q₃。"
          }
        }
      }
    },
    "dl.d.tariff.ex.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Under free trade the domestic price equals the world price Pw and imports fill the gap between Q₁ and Q₄. Drag the line up to add a tariff."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En libre-échange, le prix intérieur égale le prix mondial Pw et les importations comblent l'écart entre Q₁ et Q₄. Faites glisser la droite vers le haut pour ajouter un droit de douane."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自由貿易では国内価格は世界価格 Pw と等しく、Q₁ と Q₄ の差を輸入が埋めます。線を上へドラッグすると関税がかかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자유무역에서는 국내 가격이 세계가격 Pw와 같고, Q₁과 Q₄의 차이를 수입이 채웁니다. 선을 위로 드래그해 관세를 매겨 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自由贸易时国内价格等于世界价格 Pw，Q₁ 与 Q₄ 之间的缺口靠进口填补。把这条线向上拖动来加关税。"
          }
        }
      }
    },
    "dl.d.tariff.ex.prohibitive": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tariff is so high that imports stop: the market falls back to the domestic equilibrium, and the government collects nothing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le droit est si élevé que les importations s'arrêtent : le marché revient à l'équilibre intérieur et l'État ne perçoit rien."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "関税が高すぎて輸入が止まり、市場は国内均衡に戻ります。政府の関税収入もありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관세가 너무 높아 수입이 멈추고 시장은 국내 균형으로 돌아갑니다. 정부의 관세수입도 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关税高到进口完全停止：市场回到国内均衡，政府也收不到任何关税。"
          }
        }
      }
    },
    "dl.d.tariff.ex.removed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removing the tariff brings the price back down from Pw + t to Pw. Imports grow from Q₂–Q₃ to Q₁–Q₄, consumers gain a + b + c + d, domestic producers lose a, the government loses c, and the deadweight losses b and d disappear."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer le droit de douane ramène le prix de Pw + t à Pw. Les importations passent de Q₂–Q₃ à Q₁–Q₄, les consommateurs gagnent a + b + c + d, les producteurs nationaux perdent a, l'État perd c, et les pertes sèches b et d disparaissent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "関税を撤廃すると価格は Pw + t から Pw に戻ります。輸入は Q₂–Q₃ から Q₁–Q₄ に増え、消費者は a + b + c + d を得て、国内生産者は a を、政府は c を失い、死荷重 b と d は消えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관세를 없애면 가격이 Pw + t에서 Pw로 돌아옵니다. 수입은 Q₂–Q₃에서 Q₁–Q₄로 늘고, 소비자는 a + b + c + d를 얻으며, 국내 생산자는 a를, 정부는 c를 잃고, 사중손실 b와 d는 사라집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消关税后价格从 Pw + t 回落到 Pw。进口从 Q₂–Q₃ 扩大到 Q₁–Q₄，消费者获得 a + b + c + d，国内生产者损失 a，政府损失 c，无谓损失 b 和 d 消失。"
          }
        }
      }
    },
    "dl.d.tariff.importsFree": {
      "extractionState": "manual",
      "localizations": {
