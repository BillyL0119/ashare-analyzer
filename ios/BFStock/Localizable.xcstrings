    "gv.how.0.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each turn is a quarter"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tour = un trimestre"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1ターン＝1四半期"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 턴은 한 분기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每回合是一个季度"
          }
        }
      }
    },
    "gv.how.0.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the latest inflation and unemployment figures and set the rate for the quarter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisez les derniers chiffres de l'inflation et du chômage, puis fixez le taux du trimestre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新のインフレ率と失業率を見て、その四半期の金利を決めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최신 물가상승률과 실업률을 보고 그 분기의 금리를 정합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看最新的通胀和失业数据，决定这个季度的利率。"
          }
        }
      }
    },
    "gv.how.1.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Policy works with a lag"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La politique agit avec retard"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "政策には時間差がある"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정책에는 시차가 있다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "政策有时滞"
          }
        }
      }
    },
    "gv.how.1.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rates take several quarters to bite, so today's decision shows up in next year's data."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les taux mettent plusieurs trimestres à agir : votre décision d'aujourd'hui se voit dans les chiffres de l'an prochain."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "金利の効果は数四半期後に表れます。今日の判断は来年のデータに出ます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "금리는 몇 분기가 지나야 효과가 나타납니다. 오늘의 결정은 내년 데이터에 반영됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "利率要过几个季度才见效，今天的决定要看明年的数据。"
          }
        }
      }
    },
    "gv.how.2.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare with the real Fed"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparez avec la vraie Fed"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本物のFRBと比べる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진짜 연준과 비교"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "和真实的美联储比"
          }
        }
      }
    },
    "gv.how.2.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The goals are 2% inflation and full employment. At the end, see who got closer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les objectifs : 2 % d'inflation et le plein emploi. À la fin, voyez qui s'en est le plus approché."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標は2%のインフレと完全雇用。最後にどちらが目標に近かったかを比べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표는 2% 물가와 완전고용. 마지막에 누가 목표에 더 가까웠는지 봅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标是 2% 的通胀和充分就业。结束后看看你和美联储谁离目标更近。"
          }
        }
      }
    },
    "gv.inflation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inflation"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inflation"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インフレ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물가상승률"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通胀"
          }
        }
      }
    },
    "gv.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go back to a real turning point and set US interest rates yourself, one quarter at a time. The data is real history; only where your choices differ from the Fed's does the outcome change, following textbook economics. Can you do better than the real Fed?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revenez à un vrai tournant de l'histoire et fixez vous-même les taux américains, trimestre après trimestre. Les données sont réelles ; seul l'écart entre vos choix et ceux de la Fed change le résultat, selon les mécanismes des manuels. Ferez-vous mieux que la vraie Fed ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実際の歴史の転換点に戻り、四半期ごとに米国の金利を決めます。データは本物の歴史で、あなたの判断がFRBと違う部分だけが教科書どおりの経済の仕組みで結果を変えます。本物のFRBよりうまくやれますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제 역사의 전환점으로 돌아가 분기마다 미국 금리를 직접 정합니다. 데이터는 진짜 역사이고, 당신의 선택이 연준과 다른 부분만 교과서의 경제 원리에 따라 결과가 바뀝니다. 진짜 연준보다 잘할 수 있을까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回到真实的历史关头，由你决定美国的利率，一个季度一次。经济的数据都是真实历史，只有你和美联储做法不同的地方，才会按教科书里的规律改变结果。你能比真实的美联储做得更好吗？"
          }
        }
      }
    },
