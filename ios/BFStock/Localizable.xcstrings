    "dl.d.forex.ex.dir.up": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "appreciated"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "s'est appréciée"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上昇しました"
          }
        },
        "ko": {
          "stringUnit": {
