    "dl.d.tax.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift supply vertically by the tax per unit (S₁ → S₂). The tax revenue rectangle sits between the price consumers pay and the price producers keep."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacez l'offre verticalement du montant de la taxe par unité (S₁ → S₂). Le rectangle de recette fiscale se situe entre le prix payé par les consommateurs et celui que gardent les producteurs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "供給曲線を1単位あたりの税額だけ上へ動かします（S₁ → S₂）。税収の長方形は消費者が払う価格と生産者が受け取る価格の間にあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공급곡선을 단위당 세액만큼 위로 이동시킵니다(S₁ → S₂). 조세수입 직사각형은 소비자가 내는 가격과 생산자가 받는 가격 사이에 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "供给曲线按每单位税额垂直上移（S₁ → S₂）。税收矩形位于消费者支付的价格和生产者保留的价格之间。"
          }
        }
      }
    },
