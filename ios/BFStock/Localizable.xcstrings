    "gv.taylorNeg": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Taylor rule suggests %1$@, a negative rate, but rates cannot go below 0. This is the \"zero lower bound\"."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La règle de Taylor suggère %1$@, un taux négatif, mais les taux ne peuvent pas descendre sous 0 : c'est la « borne zéro »."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テイラー・ルールは%1$@、つまりマイナス金利を示していますが、金利は0より下げられません。これが「ゼロ金利制約」です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테일러 준칙은 %1$@, 즉 마이너스 금리를 제안하지만 금리는 0 아래로 내릴 수 없습니다. 이것이 '제로 금리 하한'입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "泰勒规则建议 %1$@，也就是负利率，但利率不能低于 0。这就是“零利率下限”。"
          }
        }
      }
    },
    "gv.taylorShow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示参考"
          }
        }
      }
    },
    "gv.taylorText": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Economist John Taylor's simple formula (1993) suggests a rate of about %1$@. It looks only at inflation and the output gap, not at special situations like a financial crisis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La formule simple de l'économiste John Taylor (1993) suggère un taux d'environ %1$@. Elle ne regarde que l'inflation et l'écart de production, pas les situations exceptionnelles comme une crise financière."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "経済学者テイラー（1993年）の簡単な式では、金利は約%1$@が目安です。インフレと需給ギャップだけを見ており、金融危機のような特別な状況は考えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경제학자 테일러(1993)의 간단한 공식은 금리 약 %1$@를 제안합니다. 물가와 경기 갭만 보고, 금융위기 같은 특수한 상황은 고려하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "经济学家泰勒（1993）的简单公式建议利率约为 %1$@。它只看通胀和经济缺口，不考虑金融危机等特殊情况。"
          }
        }
      }
    },
