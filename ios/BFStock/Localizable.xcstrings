    "gv.card": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set US interest rates quarter by quarter through 2021, 1979 or 2007, then compare your record with the real Fed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixez les taux américains trimestre par trimestre en 2021, 1979 ou 2007, puis comparez-vous à la vraie Fed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2021年のインフレ、1979年のボルカー、2007年の金融危機で四半期ごとに金利を決め、本物のFRBと成績を比べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2021년 인플레이션, 1979년 볼커, 2007년 금융위기 때로 돌아가 분기마다 금리를 정하고 진짜 연준과 비교해 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回到 2021 通胀、1979 沃尔克、2007 金融危机，每个季度亲手定利率，再和真实的美联储比成绩。"
          }
        }
      }
    },
