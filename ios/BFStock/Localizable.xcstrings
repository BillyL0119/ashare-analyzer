          }
        }
      }
    },
    "dl.d.adas.blurb": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggregate demand with short-run and long-run aggregate supply: demand shocks, supply shocks and output gaps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande globale et offre globale à court et à long terme : chocs de demande, chocs d'offre et écarts de production."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "総需要と短期・長期の総供給：需要ショック、供給ショック、GDPギャップ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "총수요와 단기·장기 총공급: 수요 충격, 공급 충격, 산출 갭."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "总需求与短期、长期总供给：需求冲击、供给冲击和产出缺口。"
          }
        }
      }
    },
    "dl.d.adas.dragAD": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggregate demand: drag left or right"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande globale : glisser à gauche ou à droite"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "総需要曲線：左右にドラッグ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "총수요곡선: 좌우로 드래그"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "总需求曲线：左右拖动"
          }
        }
      }
    },
    "dl.d.adas.dragLRAS": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long-run aggregate supply: drag left or right"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Offre globale de long terme : glisser à gauche ou à droite"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長期総供給曲線：左右にドラッグ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장기총공급곡선: 좌우로 드래그"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长期总供给曲线：左右拖动"
          }
        }
      }
    },
    "dl.d.adas.dragSRAS": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Short-run aggregate supply: drag left or right"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Offre globale de court terme : glisser à gauche ou à droite"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短期総供給曲線：左右にドラッグ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단기총공급곡선: 좌우로 드래그"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "短期总供给曲线：左右拖动"
          }
        }
      }
    },
    "dl.d.adas.ex.adDown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggregate demand fell (AD₁ → AD₂). Real GDP and the price level both fall, a movement down along SRAS, and unemployment rises."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La demande globale baisse (AD₁ → AD₂). Le PIB réel et le niveau des prix reculent, le long de SRAS, et le chômage augmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "総需要が減少しました（AD₁ → AD₂）。実質GDPと物価水準がともに下がり、失業が増えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "총수요가 감소했습니다(AD₁ → AD₂). 실질 GDP와 물가수준이 모두 내려가고 실업이 늘어납니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "总需求减少（AD₁ → AD₂）。实际 GDP 和物价水平都下降，沿 SRAS 向下移动，失业增加。"
          }
        }
      }
    },
    "dl.d.adas.ex.adUp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggregate demand increased (AD₁ → AD₂). Firms respond by producing more, so real GDP and the price level both rise: a movement up along SRAS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La demande globale augmente (AD₁ → AD₂). Les entreprises produisent davantage : le PIB réel et le niveau des prix montent, le long de SRAS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "総需要が増加しました（AD₁ → AD₂）。企業は生産を増やし、実質GDPと物価水準がともに上がります（SRAS 上の移動）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "총수요가 증가했습니다(AD₁ → AD₂). 기업이 생산을 늘려 실질 GDP와 물가수준이 모두 오릅니다(SRAS를 따라 이동)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "总需求增加（AD₁ → AD₂）。企业增加生产，实际 GDP 和物价水平都上升，这是沿 SRAS 向上的移动。"
          }
        }
      }
    },
    "dl.d.adas.ex.adjusted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long-run self-adjustment: wages and other input prices catch up, shifting SRAS until output is back at full employment. Only the price level ends up different (the classical view; Keynesians argue this can take a long time)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustement de long terme : les salaires et les autres coûts s'adaptent, SRAS se déplace jusqu'au retour au plein emploi. Seul le niveau des prix a changé (vision classique ; les keynésiens estiment que cela peut prendre longtemps)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長期の自己調整：賃金などの投入価格が追いつき、産出量が完全雇用水準に戻るまで SRAS が動きます。最後に変わるのは物価水準だけです（古典派の見方。ケインズ派は時間がかかると考えます）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장기 자기조정: 임금 등 투입물 가격이 따라 움직여 산출이 완전고용 수준으로 돌아올 때까지 SRAS가 이동합니다. 결국 달라지는 것은 물가수준뿐입니다(고전학파의 관점이며, 케인스학파는 오래 걸릴 수 있다고 봅니다)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长期自我调整：工资和其他投入品价格随之调整，SRAS 移动，直到产出回到充分就业水平，最终只有物价水平不同（这是古典学派的观点；凯恩斯学派认为这个过程可能很漫长）。"
          }
        }
      }
    },
    "dl.d.adas.ex.atFull": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Output is at full employment, so there is no output gap."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La production est au plein emploi : il n'y a pas d'écart de production."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "産出量は完全雇用水準にあり、産出ギャップはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "산출이 완전고용 수준이어서 산출 갭이 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "产出处于充分就业水平，没有产出缺口。"
          }
        }
      }
    },
    "dl.d.adas.ex.gapInf": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Output is now above full-employment output: %1$@. The tight labour market pushes up wages and prices."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La production est désormais supérieure à celle de plein emploi : %1$@. Le marché du travail tendu pousse salaires et prix à la hausse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "産出量が完全雇用水準を上回っています（%1$@）。逼迫した労働市場が賃金と物価を押し上げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 산출이 완전고용 수준보다 높습니다(%1$@). 빠듯한 노동시장이 임금과 물가를 끌어올립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在产出高于充分就业产出：出现%1$@，紧张的劳动力市场推高工资和物价。"
          }
        }
      }
    },
    "dl.d.adas.ex.gapRec": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Output is now below full-employment output: %1$@. Unemployment is above its natural rate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La production est désormais inférieure à celle de plein emploi : %1$@. Le chômage dépasse son taux naturel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "産出量が完全雇用水準を下回っています（%1$@）。失業率は自然失業率より高くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 산출이 완전고용 수준보다 낮습니다(%1$@). 실업률이 자연실업률보다 높습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在产出低于充分就业产出：出现%1$@，失业率高于自然失业率。"
          }
        }
      }
    },
    "dl.d.adas.ex.lras": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The economy's productive capacity grew, so LRAS (and SRAS) shift right. Full-employment output rises, and the economy can grow without extra pressure on prices."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La capacité de production de l'économie augmente : LRAS (et SRAS) se déplacent à droite. La production de plein emploi progresse et la croissance n'ajoute pas de pression sur les prix."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "経済の生産能力が高まり、LRAS（と SRAS）が右へシフトします。完全雇用産出量が増え、物価を余分に押し上げずに成長できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경제의 생산능력이 커져 LRAS(와 SRAS)가 오른쪽으로 이동합니다. 완전고용 산출이 늘어 물가 압력을 키우지 않고도 성장할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "经济的生产能力提高，LRAS（以及 SRAS）右移。充分就业产出增加，经济可以增长而不额外增加物价压力。"
          }
        }
      }
    },
    "dl.d.adas.ex.mixed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Several curves moved. Compare the first and last equilibrium: the overall effect on the price level and real GDP depends on how big each shift is."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plusieurs courbes ont bougé. Comparez le premier et le dernier équilibre : l'effet final sur les prix et le PIB réel dépend de l'ampleur de chaque déplacement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数の曲線が動きました。最初と最後の均衡点を比べてください。物価水準と実質GDPの最終的な変化は、それぞれのシフトの大きさで決まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 곡선이 움직였습니다. 처음과 마지막 균형점을 비교하세요. 물가수준과 실질 GDP의 최종 변화는 각 이동의 크기에 달려 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有几条曲线移动了。比较最初和最后的均衡点：物价水平和实际 GDP 的总体变化取决于每次移动的大小。"
          }
        }
      }
    },
    "dl.d.adas.ex.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The economy is in long-run equilibrium: AD, SRAS and LRAS meet at full-employment output. Drag a curve or pick a shock."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'économie est à l'équilibre de long terme : AD, SRAS et LRAS se croisent à la production de plein emploi. Déplacez une courbe ou choisissez un choc."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "経済は長期均衡にあり、AD・SRAS・LRAS が完全雇用産出量で交わっています。曲線をドラッグするか、ショックを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경제는 장기균형 상태로, AD, SRAS, LRAS가 완전고용 산출에서 만납니다. 곡선을 드래그하거나 충격을 고르세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "经济处于长期均衡：AD、SRAS 和 LRAS 相交于充分就业产出。拖动曲线或选择一个冲击。"
          }
        }
      }
    },
    "dl.d.adas.ex.srasDown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Short-run aggregate supply fell (SRAS₁ → SRAS₂), for example because energy or wage costs rose. The price level rises while real GDP falls: stagflation."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'offre globale de court terme baisse (SRAS₁ → SRAS₂), par exemple parce que l'énergie ou les salaires coûtent plus cher. Le niveau des prix monte tandis que le PIB réel baisse : c'est la stagflation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短期総供給が減少しました（SRAS₁ → SRAS₂）。たとえばエネルギーや賃金のコストが上がった場合です。物価水準が上がる一方で実質GDPは減ります（スタグフレーション）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단기총공급이 감소했습니다(SRAS₁ → SRAS₂). 예를 들어 에너지나 임금 비용이 오른 경우입니다. 물가수준은 오르고 실질 GDP는 줄어듭니다: 스태그플레이션."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "短期总供给减少（SRAS₁ → SRAS₂），例如能源或工资成本上升。物价水平上升而实际 GDP 下降：滞胀。"
          }
        }
      }
    },
    "dl.d.adas.ex.srasUp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Short-run aggregate supply increased (SRAS₁ → SRAS₂) as costs fell. Real GDP rises and the price level falls."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'offre globale de court terme augmente (SRAS₁ → SRAS₂) grâce à des coûts plus bas. Le PIB réel progresse et le niveau des prix baisse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コスト低下で短期総供給が増加しました（SRAS₁ → SRAS₂）。実質GDPが増え、物価水準は下がります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비용이 내려 단기총공급이 증가했습니다(SRAS₁ → SRAS₂). 실질 GDP는 늘고 물가수준은 내려갑니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "成本下降使短期总供给增加（SRAS₁ → SRAS₂）。实际 GDP 上升，物价水平下降。"
          }
        }
      }
    },
