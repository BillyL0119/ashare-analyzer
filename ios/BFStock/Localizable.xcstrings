    "dl.d.adas.adjustBtn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show long-run self-adjustment"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Montrer l'ajustement de long terme"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長期の自己調整を表示"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장기 자기조정 보기"
          }
        },
        "zh-Hans": {
