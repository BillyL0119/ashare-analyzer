    "dl.subtitleApp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the curves or pick a real-world shock: the diagram redraws itself with the labels examiners look for and explains what happened."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser les courbes ou choisissez un choc réel : le graphique se redessine avec les légendes attendues par les correcteurs et explique ce qui s'est passé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曲線をドラッグするか、現実のショックを選ぶと、採点者が求めるラベル付きで図が描き直され、何が起きたかを説明します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "곡선을 드래그하거나 실제 충격을 고르면, 채점자가 요구하는 표기대로 그래프가 다시 그려지고 무슨 일이 일어났는지 설명합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动曲线或选择一个真实冲击，图表会按考官要求的标注自动重画，并解释发生了什么。"
          }
        }
