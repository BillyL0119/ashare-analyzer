    "dl.d.externality.policy.neg_consumption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ways to fix it: an indirect tax, bans or age limits, and information campaigns."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Solutions : une taxe indirecte, des interdictions ou limites d'âge, et des campagnes d'information."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対策：間接税、禁止や年齢制限、情報提供キャンペーン。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해결책: 간접세, 금지나 연령 제한, 정보 제공 캠페인."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纠正方法：间接税、禁令或年龄限制，以及信息宣传。"
          }
        }
      }
    },
    "dl.d.externality.policy.neg_production": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ways to fix it: a tax equal to the external cost per unit, regulation, or tradable pollution permits."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Solutions : une taxe égale au coût externe par unité, la réglementation ou des permis d'émission échangeables."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対策：1単位あたりの外部費用に等しい課税、規制、排出量取引。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해결책: 단위당 외부비용만큼의 세금, 규제, 또는 거래 가능한 오염 배출권."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纠正方法：征收等于每单位外部成本的税、管制，或可交易的排污许可证。"
          }
        }
      }
    },
    "dl.d.externality.policy.pos_consumption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ways to fix it: a subsidy, free provision by the state, or information campaigns."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Solutions : une subvention, une fourniture gratuite par l'État ou des campagnes d'information."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対策：補助金、政府による無償提供、情報提供キャンペーン。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해결책: 보조금, 정부의 무상 제공, 또는 정보 제공 캠페인."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纠正方法：补贴、由政府免费提供，或信息宣传。"
          }
        }
      }
    },
    "dl.d.externality.policy.pos_production": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ways to fix it: subsidise the activity, or have the state fund the research or training itself."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Solutions : subventionner l'activité, ou faire financer directement la recherche ou la formation par l'État."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対策：その活動への補助金、または研究や研修を政府が直接支援する。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해결책: 해당 활동에 보조금을 주거나 정부가 연구·교육을 직접 지원."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纠正方法：补贴这项活动，或由政府直接资助研发和培训。"
          }
        }
      }
    },
