    "dl.d.externality.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Label the private and social curves, mark the market quantity and the social optimum, and make sure the welfare-loss triangle points towards the social optimum."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nommez les courbes privées et sociales, indiquez la quantité de marché et l'optimum social, et orientez le triangle de perte de bien-être vers l'optimum social."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "私的な曲線と社会的な曲線にラベルを付け、市場の数量と社会的最適量を示し、厚生損失の三角形が社会的最適点を指すように描きましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사적 곡선과 사회적 곡선에 이름을 붙이고, 시장 거래량과 사회적 최적량을 표시하세요. 후생손실 삼각형의 꼭짓점은 사회적 최적점을 향해야 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标清私人曲线和社会曲线，标出市场数量和社会最优数量，福利损失三角形的尖角要指向社会最优点。"
          }
        }
      }
    },
    "dl.d.forex.blurb": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The market for a currency: what makes it appreciate or depreciate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le marché d'une monnaie : ce qui la fait s'apprécier ou se déprécier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通貨の市場：何が通貨高や通貨安をもたらすのか。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통화 시장: 무엇이 통화 가치를 오르거나 내리게 하는지."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一种货币的市场：什么让它升值或贬值。"
          }
        }
      }
    },
    "dl.d.forex.ex.appEffects": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A stronger currency makes exports dearer abroad and imports cheaper at home: it can lower inflation but hurts exporters."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une monnaie plus forte rend les exportations plus chères à l'étranger et les importations moins chères : elle peut freiner l'inflation mais pénalise les exportateurs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通貨高は輸出品を海外で割高に、輸入品を国内で割安にします。インフレを抑える一方、輸出企業には逆風です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통화 강세는 수출품을 해외에서 비싸게, 수입품을 국내에서 싸게 만듭니다. 인플레이션은 낮출 수 있지만 수출 기업에는 불리합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本币升值让出口在海外变贵、进口在国内变便宜：可能压低通胀，但出口企业受损。"
          }
        }
      }
    },
    "dl.d.forex.ex.both": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both curves moved; overall the currency %1$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux courbes ont bougé ; au total, la monnaie %1$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方の曲線が動きました。全体として通貨は%1$@。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 곡선이 모두 이동했습니다. 전체적으로 통화 가치가 %1$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两条曲线都移动了；总体来看货币%1$@。"
          }
        }
      }
    },
    "dl.d.forex.ex.dDown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Demand for the currency fell (D₁ → D₂), so it depreciates: its price falls from ER₁ to ER₂."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La demande de la monnaie baisse (D₁ → D₂) : elle se déprécie, son prix passe de ER₁ à ER₂."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通貨への需要が減り（D₁ → D₂）、通貨安になります。価格は ER₁ から ER₂ へ下がります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통화에 대한 수요가 줄어(D₁ → D₂) 통화 가치가 내립니다(절하). 가격이 ER₁에서 ER₂로 내려갑니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对该货币的需求减少（D₁ → D₂），货币贬值：价格从 ER₁ 降到 ER₂。"
          }
        }
      }
    },
    "dl.d.forex.ex.dUp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Demand for the currency rose (D₁ → D₂), so it appreciates: its price rises from ER₁ to ER₂."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La demande de la monnaie augmente (D₁ → D₂) : elle s'apprécie, son prix passe de ER₁ à ER₂."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通貨への需要が増え（D₁ → D₂）、通貨高になります。価格は ER₁ から ER₂ へ上がります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통화에 대한 수요가 늘어(D₁ → D₂) 통화 가치가 오릅니다(절상). 가격이 ER₁에서 ER₂로 오릅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对该货币的需求增加（D₁ → D₂），货币升值：价格从 ER₁ 升到 ER₂。"
          }
        }
      }
    },
    "dl.d.forex.ex.depEffects": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A weaker currency makes exports cheaper abroad and imports dearer at home: it helps exporters but can push up inflation."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une monnaie plus faible rend les exportations moins chères à l'étranger et les importations plus chères : elle aide les exportateurs mais peut alimenter l'inflation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通貨安は輸出品を海外で割安に、輸入品を国内で割高にします。輸出企業には追い風ですが、インフレを押し上げることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통화 약세는 수출품을 해외에서 싸게, 수입품을 국내에서 비싸게 만듭니다. 수출 기업에는 유리하지만 인플레이션을 높일 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本币贬值让出口在海外变便宜、进口在国内变贵：有利于出口企业，但可能推高通胀。"
          }
        }
      }
    },
    "dl.d.forex.ex.dir.down": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "depreciated"
          }
        },
        "fr": {
