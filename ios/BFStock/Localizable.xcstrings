      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tariff on imported steel"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Droit de douane sur l'acier importé"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入鉄鋼への関税"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수입 철강에 관세"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对进口钢材征收关税"
          }
        }
      }
    },
    "dl.d.tariff.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark Q₁ to Q₄ on the quantity axis. Imports shrink from Q₁–Q₄ to Q₂–Q₃, and the two small triangles are the deadweight loss."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez Q₁ à Q₄ sur l'axe des quantités. Les importations passent de Q₁–Q₄ à Q₂–Q₃ ; les deux petits triangles sont la perte sèche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数量軸に Q₁〜Q₄ を書き込みます。輸入は Q₁–Q₄ から Q₂–Q₃ に縮み、2つの小さな三角形が死荷重です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수량축에 Q₁부터 Q₄까지 표시하세요. 수입은 Q₁–Q₄에서 Q₂–Q₃로 줄고, 두 개의 작은 삼각형이 사중손실입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在数量轴上标出 Q₁ 到 Q₄。进口从 Q₁–Q₄ 缩小到 Q₂–Q₃，两个小三角形就是无谓损失。"
          }
        }
      }
    },
    "dl.d.tax.blurb": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tax or subsidy per unit shifts supply vertically. See who really pays, what the government collects or spends, and the deadweight loss."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une taxe ou une subvention par unité déplace l'offre verticalement. Voyez qui paie vraiment, ce que l'État encaisse ou dépense, et la perte sèche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1単位あたりの税や補助金は供給曲線を上下に動かします。誰が実際に負担するのか、政府の収入・支出、死荷重を確かめましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단위당 세금이나 보조금은 공급곡선을 위아래로 이동시킵니다. 실제로 누가 부담하는지, 정부가 얼마를 걷거나 쓰는지, 사중손실을 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从量税或补贴使供给曲线垂直移动。看看税负实际由谁承担、政府收了或花了多少，以及无谓损失。"
          }
        }
      }
    },
    "dl.d.tax.consShare": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tax paid by consumers"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taxe payée par les consommateurs"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "消費者が負担する税"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소비자가 부담하는 세금"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "消费者承担的税"
          }
        }
      }
    },
    "dl.d.tax.dragS": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supply after the tax or subsidy: drag up or down"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Offre après taxe ou subvention : glisser vers le haut ou le bas"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "課税・補助金後の供給曲線：上下にドラッグ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "과세·보조금 후 공급곡선: 위아래로 드래그"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "征税或补贴后的供给曲线：上下拖动"
          }
        }
      }
    },
    "dl.d.tax.el.elastic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Elastic demand"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande élastique"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "弾力的な需要"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탄력적 수요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需求富有弹性"
          }
        }
      }
    },
    "dl.d.tax.el.inelastic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inelastic demand"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande inélastique"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非弾力的な需要"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비탄력적 수요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需求缺乏弹性"
          }
        }
      }
    },
    "dl.d.tax.el.unit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Similar slopes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentes proches"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "傾きが同程度"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기울기 비슷"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "斜率相近"
          }
        }
      }
    },
    "dl.d.tax.ex.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the supply curve up to add a tax, or switch to a subsidy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser l'offre vers le haut pour ajouter une taxe, ou passez à une subvention."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "供給曲線を上へドラッグすると課税、または補助金に切り替えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공급곡선을 위로 드래그하면 세금이 붙습니다. 보조금으로 바꿔 볼 수도 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把供给曲线向上拖动来加税，或切换到补贴。"
          }
        }
      }
    },
    "dl.d.tax.ex.subInc.cons": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Demand is price-inelastic, so most of the subsidy reaches consumers as a lower price."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La demande est inélastique : l'essentiel de la subvention profite aux consommateurs sous forme de prix plus bas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "需要が非弾力的なので、補助金の多くは値下がりという形で消費者に届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수요가 비탄력적이어서 보조금 대부분이 낮은 가격의 형태로 소비자에게 돌아갑니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需求缺乏弹性，补贴大部分以更低价格的形式到了消费者手里。"
          }
        }
      }
    },
    "dl.d.tax.ex.subInc.even": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The benefit is split roughly evenly between consumers and producers."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le gain est partagé à peu près également entre consommateurs et producteurs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "補助金の恩恵は消費者と生産者でおおむね半分ずつです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보조금의 혜택을 소비자와 생산자가 대략 반씩 나눕니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "补贴的好处由消费者和生产者大致平分。"
          }
        }
      }
    },
    "dl.d.tax.ex.subInc.prod": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Demand is price-elastic, so most of the subsidy stays with producers."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La demande est élastique : l'essentiel de la subvention reste aux producteurs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "需要が弾力的なので、補助金の多くは生産者に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수요가 탄력적이어서 보조금 대부분이 생산자에게 남습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需求富有弹性，补贴大部分留在了生产者手里。"
          }
        }
      }
    },
    "dl.d.tax.ex.subsidy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A subsidy per unit shifts supply down by the subsidy (S₁ → S₂). Consumers pay P₂, producers receive P₃, and output rises from Q₁ to Q₂. The rectangle is what the government pays; the red triangle is the deadweight loss from producing units worth less than they cost (unless the good has positive externalities)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une subvention par unité déplace l'offre vers le bas (S₁ → S₂). Les consommateurs paient P₂, les producteurs reçoivent P₃, et la production passe de Q₁ à Q₂. Le rectangle est la dépense de l'État ; le triangle rouge est la perte sèche due à des unités qui valent moins que leur coût (sauf externalités positives)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1単位あたりの補助金で供給曲線が補助金分だけ下へシフトします（S₁ → S₂）。消費者は P₂ を払い、生産者は P₃ を受け取り、生産量は Q₁ から Q₂ へ増えます。長方形が政府の支出、赤い三角形は費用より価値の低い生産による死荷重です（正の外部性がある場合を除く）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단위당 보조금으로 공급곡선이 보조금만큼 아래로 이동합니다(S₁ → S₂). 소비자는 P₂를 내고 생산자는 P₃를 받으며, 생산량은 Q₁에서 Q₂로 늘어납니다. 직사각형은 정부 지출, 빨간 삼각형은 비용보다 가치가 낮은 생산으로 인한 사중손실입니다(긍정적 외부효과가 없다면)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每单位补贴使供给曲线下移一个补贴额（S₁ → S₂）。消费者支付 P₂，生产者得到 P₃，产量从 Q₁ 增加到 Q₂。矩形是政府的补贴支出；红色三角形是生产了价值低于成本的产品造成的无谓损失（除非该商品有正外部性）。"
          }
        }
      }
    },
    "dl.d.tax.ex.tax": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tax per unit shifts supply up by the tax (S₁ → S₂). Consumers now pay P₂, producers keep P₃, and the gap between them is the tax. Quantity falls from Q₁ to Q₂. The shaded rectangle is the tax revenue; the red triangle is the deadweight loss."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une taxe par unité déplace l'offre vers le haut du montant de la taxe (S₁ → S₂). Les consommateurs paient désormais P₂, les producteurs gardent P₃, et l'écart est la taxe. La quantité passe de Q₁ à Q₂. Le rectangle est la recette fiscale ; le triangle rouge est la perte sèche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1単位あたりの税で供給曲線が税額分だけ上へシフトします（S₁ → S₂）。消費者は P₂ を払い、生産者の手元には P₃ が残り、その差が税です。数量は Q₁ から Q₂ へ減ります。長方形が税収、赤い三角形が死荷重です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단위당 세금으로 공급곡선이 세액만큼 위로 이동합니다(S₁ → S₂). 소비자는 P₂를 내고 생산자는 P₃를 받으며, 그 차이가 세금입니다. 거래량은 Q₁에서 Q₂로 줄어듭니다. 직사각형은 조세수입, 빨간 삼각형은 사중손실입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每单位征税使供给曲线上移一个税额（S₁ → S₂）。消费者现在支付 P₂，生产者只保留 P₃，两者之差就是税。数量从 Q₁ 降到 Q₂。阴影矩形是税收收入，红色三角形是无谓损失。"
          }
        }
      }
    },
    "dl.d.tax.ex.taxInc.cons": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Demand is price-inelastic here, so consumers bear most of the tax: the price they pay rises by almost the whole tax."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ici la demande est inélastique : les consommateurs supportent l'essentiel de la taxe, leur prix augmente presque du montant total."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでは需要が非弾力的なので、税の大部分を消費者が負担します。支払う価格がほぼ税額分上がります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서는 수요가 비탄력적이어서 세금 대부분을 소비자가 부담합니다. 내는 가격이 세액만큼 거의 다 오릅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里需求缺乏弹性，税负主要由消费者承担：他们支付的价格几乎上涨了整个税额。"
          }
        }
      }
    },
    "dl.d.tax.ex.taxInc.even": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With demand and supply about equally steep, the burden is shared roughly evenly."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Offre et demande ont des pentes proches : la charge est partagée à peu près à parts égales."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "需要と供給の傾きが同程度なので、負担はおおむね半分ずつです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수요와 공급의 기울기가 비슷해 부담을 대략 반씩 나눕니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需求和供给的陡峭程度相近，税负大致各担一半。"
          }
        }
      }
    },
    "dl.d.tax.ex.taxInc.prod": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Demand is price-elastic here, so producers bear most of the tax: buyers would switch away if the price rose much."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ici la demande est élastique : les producteurs supportent l'essentiel de la taxe, car les acheteurs partiraient si le prix montait beaucoup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでは需要が弾力的なので、税の大部分を生産者が負担します。値上げすると買い手が離れるからです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서는 수요가 탄력적이어서 세금 대부분을 생산자가 부담합니다. 가격이 많이 오르면 구매자가 떠나기 때문입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里需求富有弹性，税负主要由生产者承担：价格涨多了买家就会转向别处。"
          }
        }
      }
    },
    "dl.d.tax.govCost": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cost to the government"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coût pour l'État"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "政府の補助金支出"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정부 보조금 지출"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "政府补贴支出"
          }
        }
      }
    },
    "dl.d.tax.modes.subsidy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subsidy"
          }
        },
