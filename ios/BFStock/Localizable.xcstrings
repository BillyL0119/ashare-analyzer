    "gv.pceHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much the PCE price index rose over the past year. The Fed's 2% target uses this measure."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hausse de l'indice des prix PCE sur un an. C'est la mesure de l'objectif de 2 % de la Fed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PCE物価指数の1年前からの上昇率。FRBの2%目標はこの指標です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PCE 물가지수가 1년 전보다 얼마나 올랐는지. 연준의 2% 목표가 이 지표를 씁니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PCE 物价指数比一年前上涨多少。美联储的 2% 目标用的就是它。"
          }
        }
      }
    },
