    "gv.missHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each quarter, how far inflation was from 2% and unemployment from its natural rate, combined and averaged. Smaller is better."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque trimestre, l'écart de l'inflation à 2 % et du chômage à son taux naturel, combinés puis moyennés. Plus c'est petit, mieux c'est."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各四半期のインフレ率と2%の差、失業率と自然失業率の差を合わせて平均したもの。小さいほど良い成績です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분기마다 물가상승률이 2%에서, 실업률이 자연실업률에서 얼마나 벗어났는지를 합쳐 평균한 값입니다. 작을수록 좋습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个季度，通胀离 2% 有多远、失业率离自然失业率有多远，两者合起来取平均。越小越好。"
          }
        }
      }
    },
    "gv.missLine": {
