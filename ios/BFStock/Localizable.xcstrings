    "T+1：今日买入部分明日可卖": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "T+1: shares bought today can be sold tomorrow"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "T+1 : les actions achetées aujourd'hui sont vendables demain"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "T+1: 本日購入分は翌日に売却可能"
