          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "투기세력이 통화 약세를 예상"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "投机者预期本币会贬值"
          }
        }
      }
    },
    "dl.d.forex.shocks.tourists": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More foreign tourists visit"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus de touristes étrangers"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外国人観光客が増える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외국인 관광객 증가"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更多外国游客来访"
          }
        }
      }
    },
    "dl.d.forex.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Label the vertical axis as the price of one currency in terms of another, and name the currency on both curves (D£, S£)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nommez l'axe vertical comme le prix d'une monnaie exprimé dans une autre, et indiquez la monnaie sur les deux courbes (D£, S£)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "縦軸は「ある通貨の、別の通貨で測った価格」とし、両方の曲線にどの通貨かを書きます（D£、S£）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세로축은 한 통화를 다른 통화로 나타낸 가격으로 쓰고, 두 곡선 모두에 어느 통화인지 표시하세요(D£, S£)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纵轴写成一种货币以另一种货币表示的价格，两条曲线上都要标明是哪种货币（D£、S£）。"
          }
        }
      }
    },
    "dl.d.ped.blurb": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On a straight-line demand curve elasticity changes from point to point, and so does what a price change does to total revenue."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur une courbe de demande linéaire, l'élasticité change d'un point à l'autre, et l'effet d'un changement de prix sur la recette aussi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直線の需要曲線では弾力性が点ごとに変わり、価格変更が総収入に与える影響も変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직선 수요곡선에서는 점마다 탄력성이 달라지고, 가격 변화가 총수입에 미치는 영향도 달라집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在一条直线需求曲线上，弹性逐点变化，价格变动对总收益的影响也随之不同。"
          }
        }
      }
    },
    "dl.d.ped.cut": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cut the price"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baisser le prix"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値下げ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가격 인하"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "降价"
          }
        }
      }
    },
    "dl.d.ped.dragPoint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point on the demand curve: drag along it"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Point sur la courbe de demande : glisser le long de la courbe"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "需要曲線上の点：曲線に沿ってドラッグ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수요곡선 위의 점: 곡선을 따라 드래그"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需求曲线上的点：沿曲线拖动"
          }
        }
      }
    },
    "dl.d.ped.ex.at": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At this point |PED| ≈ %1$@, so demand is %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En ce point |PED| ≈ %1$@ : la demande est %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この点では |PED| ≈ %1$@ で、需要は%2$@です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 점에서 |PED| ≈ %1$@로, 수요는 %2$@입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一点上 |PED| ≈ %1$@，需求%2$@。"
          }
        }
      }
    },
    "dl.d.ped.ex.cutDown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The price cut from P₁ to P₂ wins few extra sales, so total revenue falls: each unit now earns less, and volume barely grows."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La baisse de prix de P₁ à P₂ attire peu de ventes supplémentaires, donc la recette totale baisse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "P₁ から P₂ への値下げでも販売量はあまり増えないので、総収入は減ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "P₁에서 P₂로 가격을 내려도 판매가 별로 늘지 않아 총수입이 줄어듭니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "价格从 P₁ 降到 P₂ 只带来很少的新增销量，总收益减少：每件赚得更少，销量却几乎没涨。"
          }
        }
      }
    },
    "dl.d.ped.ex.cutUp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The price cut from P₁ to P₂ wins many extra sales, so total revenue rises."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La baisse de prix de P₁ à P₂ attire beaucoup de ventes supplémentaires, donc la recette totale augmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "P₁ から P₂ への値下げで販売量が大きく増えるので、総収入は増えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "P₁에서 P₂로 가격을 내리자 판매가 크게 늘어 총수입이 증가합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "价格从 P₁ 降到 P₂ 带来大量新增销量，总收益增加。"
          }
        }
      }
    },
    "dl.d.ped.ex.flat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Near the midpoint, where elasticity is 1, a small price change leaves total revenue almost unchanged: this is where revenue peaks (lower panel)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Près du milieu, où l'élasticité vaut 1, une petite variation de prix laisse la recette presque inchangée : c'est là que la recette est maximale (graphique du bas)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "弾力性が1になる中点付近では、小さな価格変更で総収入はほとんど変わりません。ここで総収入が最大になります（下の図）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탄력성이 1인 중점 근처에서는 가격을 조금 바꿔도 총수입이 거의 변하지 않습니다. 여기서 총수입이 가장 큽니다(아래 그래프)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在弹性等于 1 的中点附近，价格小幅变动几乎不改变总收益：这里正是总收益的最高点（见下图）。"
          }
        }
      }
    },
    "dl.d.ped.ex.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shaded rectangle is total revenue (price × quantity). Drag the point along the curve, then try a price rise or cut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rectangle coloré est la recette totale (prix × quantité). Déplacez le point le long de la courbe, puis essayez une hausse ou une baisse de prix."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "色付きの長方形が総収入（価格 × 数量）です。点を曲線に沿って動かし、値上げや値下げを試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "색칠된 직사각형이 총수입(가격 × 수량)입니다. 점을 곡선을 따라 움직인 뒤 가격 인상이나 인하를 해 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阴影矩形是总收益（价格 × 数量）。沿曲线拖动这个点，再试试提价或降价。"
          }
        }
      }
    },
    "dl.d.ped.ex.riseDown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The price rise from P₁ to P₂ drives many buyers away, so total revenue falls: the red rectangle lost is bigger than the green one gained."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La hausse de prix de P₁ à P₂ fait fuir beaucoup d'acheteurs, donc la recette totale baisse : le rectangle rouge perdu dépasse le vert gagné."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "P₁ から P₂ への値上げで多くの買い手が離れるので、総収入は減ります。赤の減少分が緑の増加分より大きくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "P₁에서 P₂로 가격을 올리자 많은 구매자가 떠나 총수입이 줄어듭니다. 빨간색 감소분이 초록색 증가분보다 큽니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "价格从 P₁ 升到 P₂ 赶走了大量买家，总收益减少：红色的减少部分大于绿色的增加部分。"
          }
        }
      }
    },
    "dl.d.ped.ex.riseUp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The price rise from P₁ to P₂ costs only a few sales, so total revenue rises: the green rectangle gained is bigger than the red one lost."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La hausse de prix de P₁ à P₂ ne coûte que peu de ventes, donc la recette totale augmente : le rectangle vert gagné dépasse le rouge perdu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "P₁ から P₂ への値上げで失う販売量はわずかなので、総収入は増えます。緑の増加分が赤の減少分より大きくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "P₁에서 P₂로 가격을 올려도 판매가 조금만 줄어 총수입이 늘어납니다. 초록색 증가분이 빨간색 감소분보다 큽니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "价格从 P₁ 升到 P₂ 只损失了少量销量，总收益增加：绿色的增加部分大于红色的减少部分。"
          }
        }
      }
    },
    "dl.d.ped.gained": {
