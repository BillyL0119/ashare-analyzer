    "止损单在价格到达触发价后按市价成交，常用来止损。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A stop order becomes a market order once the price reaches the stop; often used to cut losses."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ordre stop devient un ordre au marché quand le cours atteint le stop ; utile pour limiter les pertes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "逆指値注文は価格がトリガーに達すると成行になります。損切りによく使われます。"
          }
        },
        "ko": {
