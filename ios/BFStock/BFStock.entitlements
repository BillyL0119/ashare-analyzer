<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Class invite links (https://bestfriendstock.com/class/CODE) open the app. The site serves
	     /.well-known/apple-app-site-association naming this app. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:bestfriendstock.com</string>
		<string>applinks:www.bestfriendstock.com</string>
	</array>
</dict>
</plist>
